{
  "openapi": "3.0.3",
  "info": {
    "title": "Citizen Space API",
    "description": "Public API for citizenspace.ainative.studio.",
    "version": "1.0.0"
  },
  "servers": [{ "url": "https://citizenspace.ainative.studio" }],
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Health check",
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "ok" },
                    "timestamp": { "type": "string", "format": "date-time" },
                    "uptime": { "type": "number" },
                    "environment": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/contact": {
      "post": {
        "summary": "Submit the contact form",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "email", "topic", "message"],
                "properties": {
                  "name": { "type": "string" },
                  "email": { "type": "string", "format": "email" },
                  "topic": {
                    "type": "string",
                    "enum": ["general", "booking", "partnership", "press"]
                  },
                  "message": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Message submitted" },
          "400": { "description": "Validation error" }
        }
      }
    }
  }
}
